// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/app/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Track Items Schema
model TrackItem {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId

  title       String
  description String?

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  TrackAttributes TrackAttributes[]
}

enum TrackAttributeValueType {
  STRING
  INT
  FLOAT
  DATETIME
  DURATION
}

model TrackAttributes {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  userId  String @db.ObjectId
  trackId String @db.ObjectId

  title         String
  value         String?
  valueInt      Int?
  valueFloat    Float?
  valueDate     DateTime?
  valueDuration Int? // Duration in minutes
  valueType     TrackAttributeValueType @default(STRING)

  // Timer state fields for DURATION type attributes
  timerStartTime DateTime? // When timer was started
  timerEndTime   DateTime? // When timer was stopped (null if running)
  isTimerRunning Boolean?  @default(false) // True if timer is currently running

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackItem TrackItem @relation(fields: [trackId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// User Management Schema
model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  refresh_token_expires_in Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  name            String?
  email           String?           @unique
  emailVerified   DateTime?
  image           String?
  password        String?           // For credentials-based auth
  role            UserRole          @default(USER)
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  
  accounts        Account[]
  sessions        Session[]
  TrackItem       TrackItem[]
  TrackAttributes TrackAttributes[]
  passwordResets  PasswordReset[]
  timeTopics      TimeTopic[]
  timeSessions    TimeSession[]
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordReset {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum RegistrationPolicyType {
  DOMAIN
  EMAIL
}

model RegistrationPolicy {
  id        String                    @id @default(auto()) @map("_id") @db.ObjectId
  type      RegistrationPolicyType
  value     String                    // Either domain (e.g., "example.com") or specific email
  isAllowed Boolean                   @default(true)
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt
  
  @@unique([type, value])
}

// Time Tracking Schema - Separate from Track Items
model TimeTopic {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  userId      String  @db.ObjectId
  name        String
  color       String  @default("#6366f1") // Indigo default
  icon        String? // Lucide icon name
  isFavorite  Boolean @default(false)
  isArchived  Boolean @default(false)
  sortOrder   Int     @default(0)

  // Cached statistics (pre-computed)
  durationBreakdown   Json?                // Hierarchical breakdown by year/month/day for charts
  lastTrackedAt       DateTime?
  sessionCount        Int      @default(0) // Total number of sessions

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions  TimeSession[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([userId, name])
  @@index([userId, isFavorite])
  @@index([userId, isArchived])
}

model TimeSession {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  topicId   String   @db.ObjectId
  
  startTime   DateTime
  endTime     DateTime?
  durationMs  BigInt?   // Calculated on stop
  isRunning   Boolean   @default(true)
  notes       String?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic     TimeTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, isRunning])
  @@index([topicId, startTime])
}

// Exercise Schema
model Exercise {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  exerciseId Int    @unique // Original exercise ID from the data source
  title      String
  titleRaw   String @map("title_raw")

  // Image data as JSON for flexibility
  img         Json? // Contains male, female, mid, fid URLs
  imgPng      Json? @map("img_png") // PNG versions
  anim        Json? // Animation URLs and IDs
  singleAnim  Json? @map("single_anim") // Single animation URLs
  localImages Json? @map("local_images") // Local downloaded images with numbered indexes for animation

  permalink            String?
  type                 String  @default("Work Out")
  tags                 String?
  isCardio             Boolean @default(false) @map("is_cardio")
  isNewEx              Boolean @default(false) @map("is_new_ex")
  presetNotes          String? @map("preset_notes")
  isPersonalPresetNote Boolean @default(false) @map("is_personal_preset_note")
  isYoga               Boolean @default(false) @map("is_yoga")
  sanskrit             String?
  sanskritRaw          String? @map("sanskrit_raw")
  alignmentCues        String? @map("alignment_cues")
  commonName           String? @map("common_name")
  eet                  String?
  isYogaPremium        Boolean @default(false) @map("is_yoga_premium")
  audio                String?
  isFav                Boolean @default(false) @map("is_fav")

  // Equipment and muscle groups as comma-separated strings
  equipment        String? // Comma-separated list of equipment
  primaryMuscles   String? @map("primary_muscles") // Comma-separated list of primary muscles
  secondaryMuscles String? @map("secondary_muscles") // Comma-separated list of secondary muscles
  instructions     String? // Exercise instructions

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
