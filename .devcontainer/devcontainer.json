{
  "name": "Home Hub",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:20-bullseye",
  "workspaceFolder": "/workspaces/home-hub",

  // Features to install
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/python:1": { "version": "3.11" }
  },

  // Mount the downloads folder
  "mounts": ["source=${localEnv:HOME}/Downloads,target=/downloads,type=bind"],

  // Port configuration
  "forwardPorts": [3000, 3001],
  "portsAttributes": {
    "3000": {
      "label": "Next.js App",
      "onAutoForward": "notify"
    },
    "3001": {
      "label": "Next.js App (alt)",
      "onAutoForward": "notify"
    }
  },

  // Environment variables to connect to MongoDB on host
  "remoteEnv": {
    "DATABASE_URL": "mongodb://host.docker.internal:27018/home-hub"
  },

  // Run commands after container is created
  "postCreateCommand": "bash .devcontainer/post-create.sh",

  // Customize the VS Code environment
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "ms-vscode.makefile-tools",
        "prisma.prisma",
        "mongodb.mongodb-vscode"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "[typescript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[typescriptreact]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        }
      }
    }
  },

  // Run as non-root user
  "remoteUser": "node",

  // Resource limits (adjust as needed)
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb"
  }
}
