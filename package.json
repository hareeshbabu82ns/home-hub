{
  "name": "home-hub",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "lint:strict": "eslint . --ext .ts,.tsx,.js,.jsx --max-warnings 0",
    "preview": "next build && next start",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md,mdx}\" --cache",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md,mdx}\" --cache",
    "code-quality": "pnpm typecheck && pnpm lint:strict && pnpm format:check",
    "code-quality:fix": "pnpm typecheck && pnpm lint:fix && pnpm format",
    "db:gen": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "download-exercises": "tsx scripts/download-exercises.ts",
    "upload-exercises": "tsx scripts/upload-exercises.ts",
    "upload-exercises-2": "tsx scripts/upload-exercises-2.ts",
    "release:patch": "npm version patch && git push && git push --tags",
    "release:minor": "npm version minor && git push && git push --tags",
    "release:major": "npm version major && git push && git push --tags"
  },
